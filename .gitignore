# Next.js & Build Outputs
.next/
frontend/.next/
# Incremental TypeScript build state: regenerated by every `tsc`/`next build`,
# so tracking it produces a diff on each build and merge conflicts on each PR.
*.tsbuildinfo
out/
frontend/out/
dist/
frontend/dist/
build/
frontend/build/

