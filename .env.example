# Phase 10F: Production Environment Template
# Duplicate this file to .env and provide your deployment secrets

# Runtime Environment
# ENVIRONMENT=production is load-bearing, not cosmetic. It is what stops a mock
# from being substituted for a provider that is misconfigured or down -- which
# would serve fabricated questions and scores as though the model produced them
# -- and it is what disables /docs. A deployment that leaves this unset runs as
# "development" and permits exactly that substitution.
ENVIRONMENT=production
DEBUG=false
PORT=8000
WORKER_COUNT=4

# Core Security & Authentication
# REQUIRED. Minimum 32 characters; the app refuses to start without it.
# Generate a unique value per deployment (never reuse or commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_high_entropy_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=api.yourcompany.com,interview.yourcompany.com
CORS_ORIGINS=https://interview.yourcompany.com,https://app.yourcompany.com

# PostgreSQL Database Configuration
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ai_interviewer
DATABASE_URL=postgresql+asyncpg://appuser:your_secure_postgres_password_here@postgres:5432/ai_interviewer

# Redis Configuration
REDIS_URL=redis://redis:6379/0
USE_REDIS=true

# Storage Settings
# NOTE: the application reads STORAGE_TYPE and UPLOAD_DIR. The older
# STORAGE_BACKEND / STORAGE_LOCAL_PATH names are still set by
# docker-compose.production.yml but are not read by the app.
STORAGE_TYPE=local
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE_MB=10

# Operational Timeouts
# (REQUEST_TIMEOUT_SECONDS used to be listed here. Nothing in the running app
# reads it -- only the archived operations module did -- so setting it had no
# effect. The timeouts that matter are LLM_REQUEST_TIMEOUT_SECONDS below and the
# proxy's own read timeout, which nginx.conf sets to 300s.)
GRACEFUL_SHUTDOWN_TIMEOUT=15.0

# ------------------------------------------------------------------
# Provider Selection
# ------------------------------------------------------------------
# Which implementation backs each capability. Leave a provider's key blank to
# run without it: the app reports that provider as unavailable rather than
# fabricating results. Use "mock" for a no-cost, no-network deployment.
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_STT_PROVIDER=whisper
DEFAULT_TTS_PROVIDER=kokoro

# AI Provider API Keys (blank = that provider is disabled)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hqBknhU0QebV576rq8S9
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional STT provider used by the hybrid voice pipeline
DEEPGRAM_API_KEY=
# Optional key for Jina-backed job-description scraping
JINA_API_KEY=

# Voice pipeline for the *WebSocket* routes only (/ws/voice/live, /ws/voice/hybrid).
# The interview screen does not use them: it calls POST /voice/tts and POST
# /voice/stt over HTTP. "hybrid" additionally needs DEEPGRAM_API_KEY.
VOICE_PIPELINE_MODE=live

# The single voice the interviewer speaks with for a whole session. Every request
# names it explicitly, so changing it changes the interviewer everywhere at once
# rather than mid-session. Must be a voice the configured TTS provider knows.
INTERVIEWER_VOICE_ID=en_us_female_senior

# Local model selection. whisper/kokoro run on-device: no per-call API cost,
# but they download model weights on first use and need RAM/CPU accordingly.
WHISPER_MODEL_ID=openai/whisper-small
WHISPER_DEVICE=cpu
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_LANG_CODE=a

# How many Kokoro / Whisper jobs may run at once. Both are CPU-bound: past a
# small number every job slows in proportion until they all exceed their request
# timeouts, so a busy minute becomes a minute of failed transcriptions and
# unspoken questions. Raise only if measurement on the deployment host supports
# it. Separate per engine so queued TTS cannot delay transcription.
TTS_MAX_CONCURRENCY=2
STT_MAX_CONCURRENCY=2

# Load the local voice models at startup instead of on the first interview.
# Leave true for a demo: a cold Kokoro load took ~67s, which the first question
# of the first session would otherwise pay for. Set false only if no local model
# is configured above.
PREWARM_VOICE_MODELS=true

# ------------------------------------------------------------------
# Frontend (build-time)
# ------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle when `next build` runs, so
# this is consumed as a docker-compose build arg, not at container runtime.
# Must be the URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Uvicorn worker processes for the API container. Each worker is a separate
# process with its own copy of the torch/Whisper/Kokoro stack, so raise this
# only if measured load requires it. (The old WORKER_CONCURRENCY setting fed a
# background worker service that no longer exists; nothing read it.)
WEB_CONCURRENCY=1

# Logging & Observability
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# LLM Call Budget
# ------------------------------------------------------------------
# Per-request budget for one provider call. A turn spends at most two calls in
# sequence (score the answer, choose the next question), so the candidate's
# worst-case wait is roughly twice this. Sized against measurement, not taste:
# gemini-3.5-flash-lite answered a real turn-evaluation prompt in 13.6-18.9s
# across five calls, so a budget near 25s discarded work that was about to
# succeed and scored the turn with the deterministic rubric instead.
LLM_REQUEST_TIMEOUT_SECONDS=45.0
# Retries for transient faults only (429, 5xx, dropped connections). Timeouts are
# never retried -- a second attempt walks the same slow path for a second full
# budget.
LLM_MAX_RETRIES=1

# Periodic job-description scraping for the company catalogue. It runs on boot
# and every 24h, and reaches out to careers sites that commonly refuse it. Set
# false for a demo: nothing on the interview path depends on it.
ENABLE_BACKGROUND_SCRAPER=true

# Leave false: when true, any LLM failure silently serves canned mock questions
# and scores as though they were real, instead of the grounded deterministic
# fallbacks each interview component already provides.
LLM_ENABLE_FALLBACK=false
