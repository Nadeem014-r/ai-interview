# Phase 10F: Production Environment Template
# Duplicate this file to .env and provide your deployment secrets

# Runtime Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
WORKER_COUNT=4

# Core Security & Authentication
# REQUIRED. Minimum 32 characters; the app refuses to start without it.
# Generate a unique value per deployment (never reuse or commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_high_entropy_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_HOSTS=api.yourcompany.com,interview.yourcompany.com
CORS_ORIGINS=https://interview.yourcompany.com,https://app.yourcompany.com

# PostgreSQL Database Configuration
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ai_interviewer
DATABASE_URL=postgresql+asyncpg://appuser:your_secure_postgres_password_here@postgres:5432/ai_interviewer

# Redis Configuration
REDIS_URL=redis://redis:6379/0
USE_REDIS=true

# Storage Settings
# NOTE: the application reads STORAGE_TYPE and UPLOAD_DIR. The older
# STORAGE_BACKEND / STORAGE_LOCAL_PATH names are still set by
# docker-compose.production.yml but are not read by the app.
STORAGE_TYPE=local
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE_MB=10

# Operational Timeouts
REQUEST_TIMEOUT_SECONDS=30.0
GRACEFUL_SHUTDOWN_TIMEOUT=15.0

# ------------------------------------------------------------------
# Provider Selection
# ------------------------------------------------------------------
# Which implementation backs each capability. Leave a provider's key blank to
# run without it: the app reports that provider as unavailable rather than
# fabricating results. Use "mock" for a no-cost, no-network deployment.
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_STT_PROVIDER=whisper
DEFAULT_TTS_PROVIDER=kokoro

# AI Provider API Keys (blank = that provider is disabled)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hqBknhU0QebV576rq8S9
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional STT provider used by the hybrid voice pipeline
DEEPGRAM_API_KEY=
# Optional key for Jina-backed job-description scraping
JINA_API_KEY=

# Voice pipeline: "live" (Gemini Live) or "hybrid" (Deepgram -> Gemini -> TTS)
VOICE_PIPELINE_MODE=live

# Local model selection. whisper/kokoro run on-device: no per-call API cost,
# but they download model weights on first use and need RAM/CPU accordingly.
WHISPER_MODEL_ID=openai/whisper-small
WHISPER_DEVICE=cpu
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_LANG_CODE=a

# ------------------------------------------------------------------
# Frontend (build-time)
# ------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle when `next build` runs, so
# this is consumed as a docker-compose build arg, not at container runtime.
# Must be the URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Background worker (docker-compose.production.yml)
WORKER_CONCURRENCY=5

# Logging & Observability
LOG_LEVEL=INFO
